# ─── Site ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://academy.sector7.in
NEXT_PUBLIC_SITE_NAME=S7 Academy

# ─── Academy contact (used in JSON-LD, footer, application emails) ───────────
NEXT_PUBLIC_ACADEMY_PHONE=+919539108642
NEXT_PUBLIC_ACADEMY_EMAIL=academy@sector7.in
NEXT_PUBLIC_WHATSAPP_NUMBER=919539108642

# ─── Email (Resend) ─────────────────────────────────────────────────────────
RESEND_API_KEY=
# Inbox that receives new application notifications
NOTIFICATION_EMAIL=academy@sector7.in
# Verified sender (must be a Resend-verified domain/address)
FROM_EMAIL=S7 Academy <noreply@sector7.in>

# ─── Database (Postgres) ────────────────────────────────────────────────────
# Phase 1 captured applications here (optional then). Phase 2 admin REQUIRES it.
# Local dev (Docker): postgresql://s7:s7local@localhost:5433/s7academy
# Production (Neon):   postgres://user:pass@host/db?sslmode=require
DATABASE_URL=

# ─── Admin / Auth (Phase 2) ─────────────────────────────────────────────────
# Session signing secret — generate with: openssl rand -base64 32
AUTH_SECRET=
# Seed the first admin account with `npm run db:seed`
ADMIN_EMAIL=admin@sector7.in
ADMIN_PASSWORD=
ADMIN_NAME=S7 Academy Admin

# ─── Analytics (no-op until set) ────────────────────────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_CLARITY_PROJECT_ID=
